<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.Updater.ViewModels"
    xmlns:md="using:TwitchDownloaderAvalonia.Updater.Controls"
    xmlns:loc="using:TwitchDownloaderAvalonia.Updater.Markup"
    x:Class="TwitchDownloaderAvalonia.Updater.Views.UpdateWindow"
    x:DataType="vm:UpdateWindowViewModel"
    Title="{Binding Title}"
    Width="760"
    Height="580"
    MinWidth="640"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    CanResize="True"
    ShowInTaskbar="True"
    Icon="/Assets/icon.ico">
    <Window.Styles>
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Window.Styles>
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <CheckBox
                    IsChecked="{Binding AutoOfferUpdates}"
                    IsEnabled="{Binding CanDefer}"
                    Content="{loc:Translate Key=updater.auto_check}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8">
                <Button
                    Classes="secondary"
                    Content="{loc:Translate Key=updater.skip}"
                    MinWidth="132"
                    Command="{Binding SkipCommand}" />
                <Button
                    Classes="secondary"
                    Content="{loc:Translate Key=updater.later}"
                    MinWidth="132"
                    Command="{Binding LaterCommand}" />
                <Button
                    Classes="accent"
                    MinWidth="140"
                    Command="{Binding InstallCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconDownload}" Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Translate Key=updater.update_now}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <ProgressBar
                Height="8"
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"
                IsVisible="{Binding ShowProgress}" />
            <TextBlock
                Classes="muted"
                TextWrapping="Wrap"
                Text="{Binding StatusText}" />
        </StackPanel>

        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <Border
                    Width="52"
                    Height="52"
                    CornerRadius="14"
                    Background="{DynamicResource AccentBrush}"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top">
                    <PathIcon
                        Data="{StaticResource IconDownload}"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentForegroundBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="title" FontSize="22" Text="{Binding Heading}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding AppName}" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Translate Key=updater.current_version}" />
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text=" " />
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding CurrentVersionLabel}" />
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="  →  " />
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Translate Key=updater.new_version}" />
                        <Run Foreground="{DynamicResource MutedForegroundBrush}" Text=" " />
                        <Run Foreground="{DynamicResource AccentBrush}" Text="{Binding RemoteVersionLabel}" />
                    </TextBlock>
                    <TextBlock
                        Classes="muted"
                        TextWrapping="Wrap"
                        Text="{Binding Summary}" />
                </StackPanel>
            </Grid>

            <Border Classes="card" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                        <TextBlock Classes="title" FontSize="16" Text="{Binding NotesTitle}" />
                        <TextBlock
                            Classes="muted"
                            IsVisible="{Binding HasReleasedText}"
                            Text="{Binding ReleasedText}" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <md:GitHubMarkdownView Markdown="{Binding ReleaseNotes}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
