<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.ViewModels"
    xmlns:models="using:TwitchDownloaderAvalonia.Models"
    xmlns:c="using:TwitchDownloaderAvalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="760"
    d:DesignHeight="560"
    x:Class="TwitchDownloaderAvalonia.Views.VodDownloadView"
    x:DataType="vm:VodDownloadViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <DockPanel Margin="0,0,0,12">
            <Button
                DockPanel.Dock="Right"
                Content="Get Info"
                Command="{Binding GetInfoCommand}"
                IsEnabled="{Binding CanGetInfo}" />
            <TextBlock
                DockPanel.Dock="Left"
                Classes="label"
                Text="VOD link / ID"
                VerticalAlignment="Center"
                Margin="0,0,10,0" />
            <TextBox
                Margin="0,0,8,0"
                PlaceholderText="https://www.twitch.tv/videos/..."
                Text="{Binding VideoUrl}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding GetInfoCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <Border Classes="card" Margin="0,0,12,0">
                <DockPanel>
                    <Border
                        DockPanel.Dock="Top"
                        Height="168"
                        Background="{DynamicResource CardMutedBrush}"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Margin="0,0,0,10">
                        <Panel>
                            <TextBlock
                                Classes="muted"
                                Text="No thumbnail"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !InfoLoaded}" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding InfoLoaded}" />
                        </Panel>
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock
                            Classes="title"
                            Text="{Binding InfoTitle}"
                            TextWrapping="Wrap"
                            IsVisible="{Binding InfoLoaded}" />
                        <TextBlock Classes="muted" Text="Get Info to load title, channel, and length." TextWrapping="Wrap" IsVisible="{Binding !InfoLoaded}" />
                        <TextBlock Text="{Binding InfoStreamer}" TextWrapping="Wrap" IsVisible="{Binding InfoLoaded}" />
                        <TextBlock Classes="muted" Text="{Binding LengthText, StringFormat='Length: {0}'}" IsVisible="{Binding InfoLoaded}" />
                        <TextBlock Classes="muted" Text="{Binding InfoCreatedAt, StringFormat='Created: {0}'}" TextWrapping="Wrap" IsVisible="{Binding InfoLoaded}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="Quality" />
                    <ComboBox
                        ItemsSource="{Binding Qualities}"
                        SelectedItem="{Binding SelectedQuality}"
                        IsEnabled="{Binding InfoLoaded}"
                        PlaceholderText="Get Info first">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:QualityOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Classes="muted"
                        Margin="0,2,0,4"
                        Text="{Binding SuggestedFileName, StringFormat='Suggested: {0}'}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasSuggestedFileName}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                        <Button
                            Classes="accent"
                            Content="Download"
                            Command="{Binding DownloadCommand}"
                            IsVisible="{Binding !IsDownloading}" />
                        <Button
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsDownloading}" />
                    </StackPanel>

                    <Expander Header="Advanced">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Classes="label" Text="Trim mode" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton
                                    Content="Safe"
                                    GroupName="VodTrim"
                                    Command="{Binding SetTrimModeCommand}"
                                    CommandParameter="Safe"
                                    IsChecked="{Binding TrimMode, Converter={x:Static c:VideoTrimModeEqualsConverter.Instance}, ConverterParameter=Safe, Mode=OneWay}"
                                    IsEnabled="{Binding InfoLoaded}" />
                                <RadioButton
                                    Content="Exact"
                                    GroupName="VodTrim"
                                    Command="{Binding SetTrimModeCommand}"
                                    CommandParameter="Exact"
                                    IsChecked="{Binding TrimMode, Converter={x:Static c:VideoTrimModeEqualsConverter.Instance}, ConverterParameter=Exact, Mode=OneWay}"
                                    IsEnabled="{Binding InfoLoaded}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Trim start" Width="108" IsChecked="{Binding TrimStart}" IsEnabled="{Binding InfoLoaded}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="48" FormatString="0" Value="{Binding StartHour}"
                                               IsEnabled="{Binding CanEditTrimStart}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="59" FormatString="0" Value="{Binding StartMinute}"
                                               IsEnabled="{Binding CanEditTrimStart}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="59" FormatString="0" Value="{Binding StartSecond}"
                                               IsEnabled="{Binding CanEditTrimStart}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Trim end" Width="108" IsChecked="{Binding TrimEnd}" IsEnabled="{Binding InfoLoaded}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="48" FormatString="0" Value="{Binding EndHour}"
                                               IsEnabled="{Binding CanEditTrimEnd}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="59" FormatString="0" Value="{Binding EndMinute}"
                                               IsEnabled="{Binding CanEditTrimEnd}" />
                                <NumericUpDown Width="72" Minimum="0" Maximum="59" FormatString="0" Value="{Binding EndSecond}"
                                               IsEnabled="{Binding CanEditTrimEnd}" />
                            </StackPanel>

                            <TextBlock Classes="label" Text="Download threads" />
                            <NumericUpDown
                                Width="96"
                                HorizontalAlignment="Left"
                                Minimum="1"
                                Maximum="20"
                                FormatString="0"
                                Value="{Binding DownloadThreads}" />

                            <TextBlock Classes="label" Text="OAuth (subscriber-only VODs)" />
                            <TextBox Text="{Binding Oauth}" PlaceholderText="Optional" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Expander
            Grid.Row="2"
            Header="Log"
            Margin="0,12,0,0"
            IsExpanded="{Binding IsLogExpanded}">
            <DockPanel Margin="0,8,0,0">
                <Button
                    DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0"
                    Content="Clear"
                    Command="{Binding ClearLogCommand}" />
                <TextBox
                    Height="128"
                    Text="{Binding LogText}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Menlo, Consolas, monospace"
                    FontSize="13"
                    VerticalAlignment="Top" />
            </DockPanel>
        </Expander>
    </Grid>
</UserControl>
