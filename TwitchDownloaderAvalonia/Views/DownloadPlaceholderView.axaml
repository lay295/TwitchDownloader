<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="760"
    d:DesignHeight="520"
    x:Class="TwitchDownloaderAvalonia.Views.DownloadPlaceholderView"
    x:DataType="vm:DownloadPlaceholderViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Get Info" IsEnabled="False" />
            <TextBox Margin="0,0,8,0" PlaceholderText="{Binding UrlPlaceholder}" IsEnabled="False" />
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <Border Classes="card" Margin="0,0,12,0">
                <DockPanel>
                    <Border
                        DockPanel.Dock="Top"
                        Height="168"
                        Background="{DynamicResource CardMutedBrush}"
                        CornerRadius="3"
                        Margin="0,0,0,10">
                        <TextBlock Classes="muted" Text="No info" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="title" Text="{Binding Title}" />
                        <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="label" Text="Quality" />
                <ComboBox IsEnabled="False" PlaceholderText="Get Info first" />
                <Button Classes="accent" Content="{Binding PrimaryAction}" HorizontalAlignment="Left" Margin="0,8,0,8" IsEnabled="False" />
                <Expander Header="Advanced" IsEnabled="False">
                    <TextBlock Classes="muted" Margin="0,8,0,0" Text="Trim, threads, and OAuth will appear here." />
                </Expander>
            </StackPanel>
        </Grid>

        <Expander Grid.Row="2" Header="Log" Margin="0,12,0,0" IsEnabled="False">
            <TextBlock Classes="muted" Margin="0,8,0,0" Text="Log output will appear here." />
        </Expander>
    </Grid>
</ContentPage>
