<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.ViewModels"
    xmlns:c="using:TwitchDownloaderAvalonia.Converters"
    xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="740"
    d:DesignHeight="480"
    x:Class="TwitchDownloaderAvalonia.Views.QueueView"
    x:DataType="vm:QueueViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button
                    Content="Clear finished"
                    Command="{Binding ClearFinishedCommand}"
                    IsEnabled="{Binding Queue.HasFinishedItems}" />
                <Button
                    Classes="secondary"
                    Content="Cancel all"
                    Command="{Binding CancelAllCommand}"
                    IsEnabled="{Binding Queue.CanCancelAll}" />
            </StackPanel>
            <TextBlock Text="Tasks" VerticalAlignment="Center" Classes="title" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="VOD" />
                <NumericUpDown
                    Classes="compact"
                    Width="72"
                    Minimum="1"
                    Maximum="50"
                    Increment="1"
                    Value="{Binding Queue.LimitVod, Converter={x:Static c:IntDecimalConverter.Instance}, TargetNullValue={x:Static c:IntDecimalConverter.Zero}, FallbackValue={x:Static c:IntDecimalConverter.Zero}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="Clip" />
                <NumericUpDown
                    Classes="compact"
                    Width="72"
                    Minimum="1"
                    Maximum="50"
                    Increment="1"
                    Value="{Binding Queue.LimitClip, Converter={x:Static c:IntDecimalConverter.Instance}, TargetNullValue={x:Static c:IntDecimalConverter.Zero}, FallbackValue={x:Static c:IntDecimalConverter.Zero}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="Chat" />
                <NumericUpDown
                    Classes="compact"
                    Width="72"
                    Minimum="1"
                    Maximum="50"
                    Increment="1"
                    Value="{Binding Queue.LimitChat, Converter={x:Static c:IntDecimalConverter.Instance}, TargetNullValue={x:Static c:IntDecimalConverter.Zero}, FallbackValue={x:Static c:IntDecimalConverter.Zero}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="Render" />
                <NumericUpDown
                    Classes="compact"
                    Width="72"
                    Minimum="1"
                    Maximum="50"
                    Increment="1"
                    Value="{Binding Queue.LimitRender, Converter={x:Static c:IntDecimalConverter.Instance}, TargetNullValue={x:Static c:IntDecimalConverter.Zero}, FallbackValue={x:Static c:IntDecimalConverter.Zero}}" />
            </StackPanel>
        </WrapPanel>

        <Border Grid.Row="2" Classes="card" Padding="10">
            <Grid>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding Queue.HasItems}">
                    <ItemsControl ItemsSource="{Binding Queue.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueItemViewModel">
                                <Border Classes="queueItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Classes="queueThumb" VerticalAlignment="Center">
                                            <Panel>
                                                <TextBlock
                                                    Classes="muted"
                                                    FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="No thumb"
                                                    IsVisible="{Binding !HasThumbnail}" />
                                                <Image
                                                    Stretch="UniformToFill"
                                                    Source="{Binding ThumbnailBytes, Converter={x:Static c:ByteArrayToBitmapConverter.Instance}}"
                                                    IsVisible="{Binding HasThumbnail}" />
                                            </Panel>
                                        </Border>

                                        <Grid
                                            Grid.Column="1"
                                            Margin="10,0,8,0"
                                            RowDefinitions="Auto,Auto,Auto"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Classes="muted"
                                                Text="{Binding DisplayStatus}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                Grid.Row="2"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Progress}"
                                                IsVisible="{Binding ShowProgress}" />
                                        </Grid>

                                        <Border
                                            Grid.Column="2"
                                            Classes="typeChip"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TaskType}" FontSize="11" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                            <Button
                                                Content="Cancel"
                                                Command="{Binding CancelCommand}"
                                                IsVisible="{Binding CanCancel}" />
                                            <Button
                                                Content="Retry"
                                                Command="{Binding RetryCommand}"
                                                IsVisible="{Binding CanRetry}" />
                                            <Button
                                                Content="Error"
                                                Command="{Binding ShowErrorCommand}"
                                                IsVisible="{Binding HasError}" />
                                            <Button
                                                Classes="icon"
                                                Content="···"
                                                VerticalAlignment="Center">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                                        <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                                                        <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                                                        <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding !Queue.HasItems}">
                    <Image
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Stretch="Uniform"
                        anim:ImageBehavior.AnimatedSource="avares://TwitchDownloaderAvalonia/Assets/Status/ppHop.gif"
                        anim:ImageBehavior.RepeatBehavior="Forever"
                        IsVisible="{Binding AppStatus.ShowStatusImage}" />
                    <TextBlock
                        Classes="muted"
                        HorizontalAlignment="Center"
                        Text="No queued tasks." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
