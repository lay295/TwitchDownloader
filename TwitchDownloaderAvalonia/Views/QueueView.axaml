<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="740"
    d:DesignHeight="480"
    x:Class="TwitchDownloaderAvalonia.Views.QueueView"
    x:DataType="vm:QueueViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="Start" IsEnabled="False" />
                <Button Content="Cancel" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Tasks" VerticalAlignment="Center" Classes="title" />
        </DockPanel>

        <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="72,*,90,110" Margin="0,0,0,6">
                    <TextBlock Classes="muted" Text="Status" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="Title" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="Progress" />
                    <TextBlock Grid.Column="3" Classes="muted" Text="Type" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Classes="muted"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="No queued tasks." />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Classes="muted" Margin="0,8,0,0" Text="{Binding Details}" TextWrapping="Wrap" />
    </Grid>
</ContentPage>
