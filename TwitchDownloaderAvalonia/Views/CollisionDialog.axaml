<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TwitchDownloaderAvalonia.ViewModels"
    x:Class="TwitchDownloaderAvalonia.Views.CollisionDialog"
    x:DataType="vm:CollisionDialogViewModel"
    Title="File already exists"
    Width="460"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock
            Text="{Binding HeaderText}"
            TextWrapping="Wrap"
            FontWeight="SemiBold" />
        <TextBlock
            Text="{Binding FullPath}"
            TextWrapping="Wrap" />
        <CheckBox Content="Remember this choice for this session" IsChecked="{Binding Remember}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Overwrite" MinWidth="100" Command="{Binding OverwriteCommand}" />
            <Button Content="Rename" MinWidth="100" Command="{Binding RenameCommand}" />
            <Button Content="Cancel" MinWidth="100" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
